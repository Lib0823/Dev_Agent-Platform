#!/usr/bin/env bash
# JSP 문법/태그 검사: Tomcat Jasper(JspC)로 지정한 JSP 를 서블릿 소스로 변환·컴파일해 본다 (서버 기동 없이).
# 태그 라이브러리 해석을 위해 빌드 산출물(target/<war>/WEB-INF/lib)이 필요하므로 먼저 `mvn -q -DskipTests package` 또는 `preview deploy` 를 돌린다.
#   jspcheck src/main/webapp/WEB-INF/views/a.jsp [...]     인자가 없으면 git 에서 변경된 .jsp 전체
set -u
: "${PREVIEW_JAVA_HOME:?PREVIEW_JAVA_HOME(JDK 21) 이 설정되지 않았습니다}"
: "${PREVIEW_CATALINA_HOME:?PREVIEW_CATALINA_HOME(Tomcat) 이 설정되지 않았습니다}"
webapp="src/main/webapp"
[ -d "$webapp" ] || { echo "webapp 디렉터리($webapp)가 없습니다 — 저장소 루트에서 실행하세요"; exit 2; }
files=("$@")
if [ ${#files[@]} -eq 0 ]; then
  mapfile -t files < <(git diff --name-only HEAD -- '*.jsp' 2>/dev/null; git ls-files --others --exclude-standard -- '*.jsp' 2>/dev/null)
fi
if [ ${#files[@]} -eq 0 ]; then echo "검사할 .jsp 파일이 없습니다."; exit 0; fi
explib=$(ls -d target/*/WEB-INF/lib 2>/dev/null | head -1)
[ -n "$explib" ] || { echo "target/<war>/WEB-INF/lib 가 없습니다. 먼저 'mvn -q -DskipTests package' 또는 'preview deploy' 를 실행하세요."; exit 2; }
out="$(mktemp -d)"
# JspC 는 Ant Task 를 상속한다 → ant.jar 필요. tools/ant/*.jar(setup-preview.ps1 이 내려받음) 또는 ~/.m2 의 ant.
ant_jar=$(ls "$(dirname "$0")"/../../tools/ant/*.jar 2>/dev/null | head -1)
[ -n "$ant_jar" ] || ant_jar=$(ls ~/.m2/repository/org/apache/ant/ant/*/ant-*.jar 2>/dev/null | grep -v sources | tail -1)
[ -n "$ant_jar" ] || { echo "ant.jar 가 없습니다(JspC 가 Ant Task 를 상속). scripts/setup-preview.ps1 을 다시 실행하세요."; exit 2; }
ant_w=$(cygpath -w "$ant_jar" 2>/dev/null || echo "$ant_jar")
cat_w=$(cygpath -w "$PREVIEW_CATALINA_HOME" 2>/dev/null || echo "$PREVIEW_CATALINA_HOME")
java_w=$(cygpath -w "$PREVIEW_JAVA_HOME" 2>/dev/null || echo "$PREVIEW_JAVA_HOME")
explib_w=$(cygpath -w "$explib" 2>/dev/null || echo "$explib")
webapp_w=$(cygpath -w "$webapp" 2>/dev/null || echo "$webapp")
out_w=$(cygpath -w "$out" 2>/dev/null || echo "$out")
rel=()
for f in "${files[@]}"; do
  [ -f "$f" ] || { echo "SKIP (없음) $f"; continue; }
  rel+=("${f#$webapp/}")
done
[ ${#rel[@]} -gt 0 ] || exit 0
# JspC: -uriroot 웹앱, 파일 인자는 uriroot 기준 상대경로. -compile 로 자바 컴파일까지(태그/EL 오류 포함).
MSYS_NO_PATHCONV=1 "$java_w\\bin\\java.exe" -cp "$cat_w\\lib\\*;$cat_w\\bin\\*;$ant_w;$explib_w\\*" org.apache.jasper.JspC \
  -uriroot "$webapp_w" -d "$out_w" -compile -failFast "${rel[@]}" 2>&1 | iconv -f cp949 -t utf-8 -c 2>/dev/null | grep -a -v "^WARNING\|^$" | tail -40
rc=${PIPESTATUS[0]}
rm -rf "$out"
if [ "$rc" -eq 0 ]; then echo "OK   ${rel[*]}"; else echo "FAIL (JspC exit $rc)"; fi
exit $rc
