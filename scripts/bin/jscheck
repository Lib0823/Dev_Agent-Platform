#!/usr/bin/env bash
# JS 문법 검사(node --check). 번들러가 없는 프로젝트(JSP 인라인 Vue2 + 정적 JS)에서 수정한 .js 파일의 구문 오류를 바로 잡는다.
#   jscheck path/to/a.js [path/to/b.js ...]      인자가 없으면 git 에서 변경된 .js 전체
set -u
files=("$@")
if [ ${#files[@]} -eq 0 ]; then
  mapfile -t files < <(git diff --name-only HEAD -- '*.js' 2>/dev/null; git ls-files --others --exclude-standard -- '*.js' 2>/dev/null)
fi
if [ ${#files[@]} -eq 0 ]; then echo "검사할 .js 파일이 없습니다."; exit 0; fi
fail=0
for f in "${files[@]}"; do
  [ -f "$f" ] || { echo "SKIP (없음) $f"; continue; }
  if out=$(node --check "$f" 2>&1); then echo "OK   $f"; else echo "FAIL $f"; echo "$out" | head -8; fail=1; fi
done
exit $fail
