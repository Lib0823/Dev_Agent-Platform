#!/usr/bin/env bash
# 이슈 에이전트(Claude)가 수정 중인 worktree 에서 호출하는 프리뷰 명령. 실제 작업(Maven 빌드 → Tomcat 배포 → 기동 대기)은
# dev-agent 의 /api/preview/* 가 수행한다. 허용 도구 패턴: Bash(preview:*)
#   preview deploy        현재 디렉터리(worktree)를 빌드·배포하고 URL 을 출력 (수 분 소요)
#   preview redeploy      빌드 없이 target/ 의 기존 WAR 를 다시 배포(기동만, 빌드 실패가 아닌 기동 문제 재시도용)
#   preview sync [파일…]  핫 동기화(수 초): 실행 중인 프리뷰에 src/main/webapp 의 변경(JSP/JS/CSS/이미지)만 복사.
#                         파일을 안 주면 마지막 배포/동기화 이후 변경을 스스로 찾는다. Java/resources 변경은 deploy 필요.
#   preview status        프리뷰 상태/URL
#   preview log [N]       Tomcat 로그 마지막 N줄(기본 80)
#   preview stop          프리뷰 중지
set -u
PORT="${DEV_AGENT_PORT:-8777}"
BASE="http://127.0.0.1:${PORT}/api/preview"
cmd="${1:-status}"
case "$cmd" in
  deploy)
    dir="$(pwd -W 2>/dev/null || pwd)"
    curl -s -m 1500 -X POST "${BASE}/deploy" --data-urlencode "dir=${dir}"
    ;;
  redeploy)
    dir="$(pwd -W 2>/dev/null || pwd)"
    curl -s -m 900 -X POST "${BASE}/deploy" --data-urlencode "dir=${dir}" --data-urlencode "build=false"
    ;;
  sync)
    dir="$(pwd -W 2>/dev/null || pwd)"
    shift
    files="$(printf '%s\n' "$@")"
    curl -s -m 120 -X POST "${BASE}/sync" --data-urlencode "dir=${dir}" --data-urlencode "files=${files}"
    ;;
  status)
    curl -s -m 20 "${BASE}/status"
    ;;
  log)
    curl -s -m 20 -G "${BASE}/log" --data-urlencode "lines=${2:-80}"
    ;;
  stop)
    curl -s -m 120 -X POST "${BASE}/stop"
    ;;
  *)
    echo "usage: preview deploy|redeploy|sync [files…]|status|log [N]|stop"; exit 2
    ;;
esac
echo
